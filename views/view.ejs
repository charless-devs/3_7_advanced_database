<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List of Students</title>
    <style>
        table {
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid black;
        }

        th, td {
            padding: 8px;
        }
    </style>
</head>
<body>
    <table style="box-sizing: 3px;">
        <thead>
            <tr>
                <th>ID Number</th>
                <th>Lastname</th>
                <th>Firstname</th>
                <th>Age</th>
                <th>Address</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <%
                if(student.length > 0){
                    student.forEach((data)=>{

            %>
            <tr>
                <td><%= data.idnum %></td>
                <td><%= data.lastname %></td>
                <td><%= data.firstname %></td>
                <td><%= data.age %></td>
                <td><%= data.adress %></td>
                <td> 
                    <a href="/delete/<%= data.idnum %>" onclick="return 
                    confirm('Do you want to delete this account?')">Delete
                    </a> 
                     
                </td>
                
            </tr>
            <%
                })
            }
            %>
        </tbody>
    </table>

    <a href="/" type="button">
        <button>register page</button>
    </a>
</body>
</html>